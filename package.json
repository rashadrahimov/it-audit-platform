{
  "name": "it-audit-platform",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "infra:up": "docker compose up -d && node scripts/wait-infra.mjs",
    "infra:down": "docker compose down",
    "seed": "node apps/api/dist/seed.js",
    "db:generate": "pnpm --filter @it-audit/api db:generate",
    "db:migrate": "pnpm --filter @it-audit/api db:migrate",
    "db:migrate:down": "pnpm --filter @it-audit/api db:migrate:down",
    "dev": "pnpm --parallel --filter @it-audit/api --filter @it-audit/web dev",
    "dev:up": "pnpm infra:up && pnpm build && pnpm db:migrate && pnpm seed && pnpm dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.0",
    "typescript-eslint": "^8.24.0"
  }
}

# Скопируй в .env и поправь под себя. Никогда не коммить реальный .env.

# --- apps/api ---
API_PORT=3001

# --- apps/web ---
# Адрес API для server-side fetch из Next.js
API_URL=http://localhost:3001

# --- Инфраструктура (docker-compose, T-006) ---
# Хост-порты 5433/6380 вместо стандартных: 5432/6379 заняты соседним проектом.
# Рантайм — роль app (непривилегированная, иначе RLS не действует, T-011);
# миграции/DDL — владелец audit.
DATABASE_URL=postgres://app:app@localhost:5433/audit
DATABASE_URL_OWNER=postgres://audit:audit@localhost:5433/audit
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=audit-files
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="IT Audit Platform <no-reply@it-audit.localhost>"

# --- Auth (T-013) ---
# ОБЯЗАТЕЛЬНО заменить вне локальной разработки
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_TTL_SECONDS=1800
# Авто-деактивация неактивных аккаунтов, дней (0 = выключено)
INACTIVITY_DEACTIVATION_DAYS=90
# База ссылок в письмах (адрес веб-приложения)
APP_URL=http://localhost:3000

# --- OIDC SSO (T-016) ---
# Дефолты — локальный Keycloak из docker-compose (админка :8081, admin/admin).
# Для Entra ID/Google подставить их issuer/client — код одинаковый (discovery).
OIDC_ISSUER_URL=http://localhost:8081/realms/it-audit
OIDC_CLIENT_ID=it-audit-app
OIDC_CLIENT_SECRET=it-audit-dev-secret
OIDC_REDIRECT_URL=http://localhost:3001/auth/oidc/callback

# --- SAML SSO (T-024) ---
# Дефолт метадаты — SAML-descriptor realm'а it-audit локального Keycloak.
# Для ADFS: SAML_IDP_METADATA_URL=https://<adfs>/FederationMetadata/2007-06/FederationMetadata.xml
SAML_IDP_METADATA_URL=http://localhost:8081/realms/it-audit/protocol/saml/descriptor
SAML_SP_ISSUER=it-audit-saml
SAML_CALLBACK_URL=http://localhost:3001/auth/saml/callback

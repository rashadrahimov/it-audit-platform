# Скопируй в .env и поправь под себя. Никогда не коммить реальный .env.

# --- apps/api ---
API_PORT=3001

# --- apps/web ---
# Адрес API для server-side fetch из Next.js
API_URL=http://localhost:3001

# --- Инфраструктура (docker-compose, T-006) ---
# Хост-порты 5433/6380 вместо стандартных: 5432/6379 заняты соседним проектом.
# Рантайм — роль app (непривилегированная, иначе RLS не действует, T-011);
# миграции/DDL — владелец audit.
DATABASE_URL=postgres://app:app@localhost:5433/audit
DATABASE_URL_OWNER=postgres://audit:audit@localhost:5433/audit
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=audit-files
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="IT Audit Platform <no-reply@it-audit.localhost>"

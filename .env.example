# Скопируй в .env и поправь под себя. Никогда не коммить реальный .env.

# --- apps/api ---
API_PORT=3001

# --- apps/web ---
# Адрес API для server-side fetch из Next.js
API_URL=http://localhost:3001

# --- Инфраструктура (появится в T-006, docker-compose) ---
DATABASE_URL=postgres://audit:audit@localhost:5432/audit
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=audit-files
SMTP_HOST=localhost
SMTP_PORT=1025
